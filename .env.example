# Copy this file to .env and adjust values for your environment.
# api/app.py loads .env automatically on startup (python-dotenv) -- .env itself
# is gitignored, so real local settings never get committed.

# Path to the YAML config that defines model architecture, preprocessing, and
# decision thresholds.
#   configs/lightweight_real.yaml -- CPU-friendly (MobileNetV3/64-128px), what the
#                                     checkpoints in checkpoints_real/ below were
#                                     trained with. Use this unless you have a GPU
#                                     and full-scale checkpoints.
#   configs/default.yaml          -- full-scale (ResNet50/224px), GPU-recommended.
SIGVERIFY_CONFIG=configs/lightweight_real.yaml

# Directory containing trained checkpoints: static_branch.pt, dynamic_branch.pt,
# fusion.pt, and optionally calibrator.joblib + anomaly/*.joblib. Missing files
# fall back to randomly initialized weights (SignatureVerificationBundle logs a
# warning per file) rather than failing to start -- fine for a smoke test, not
# for real verification. See docs/results.md for what checkpoints_real/ actually
# measures.
SIGVERIFY_CHECKPOINTS=checkpoints_real

# Host/port used by `python api/app.py`. Irrelevant if you launch with
# `uvicorn api.app:app --host ... --port ...` instead, which takes its own
# --host/--port flags.
SIGVERIFY_HOST=127.0.0.1
SIGVERIFY_PORT=8000

# Auto-reload on code changes -- convenient for local development, never enable
# in production (it re-imports application code from disk on every change).
SIGVERIFY_RELOAD=false

# Comma-separated list of additional allowed CORS origins, only needed if you're
# running the web console (web/) from somewhere other than this API itself, e.g.
# a separate frontend dev server on another port. Leave empty for the default
# setup, where api/app.py serves web/ directly (same-origin, no CORS needed).
# Example: SIGVERIFY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SIGVERIFY_CORS_ORIGINS=

# Shared-secret key required on every /api/* request (as an `X-API-Key` header)
# and on the /ws/alerts WebSocket (as an `?api_key=` query param) once set.
# Leave empty to disable auth entirely -- the default, frictionless for local
# development. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The bundled web console (web/js/config.js, regenerated from this value at every
# server startup) sends it automatically for its own same-origin requests; this
# is meant to gate *programmatic* callers (another service, a script, curl), not
# to keep the key secret from the browser's own user -- see the comment above
# require_api_key() in api/app.py for why a pure client-side app can't do that.
SIGVERIFY_API_KEY=
